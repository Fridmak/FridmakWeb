@using TestingAppWeb.Models
@model TestingAppWeb.Models.ViewModels.AddFriendViewModel

@{
    ViewData["Title"] = "Поиск друзей";
}

<div class="page-header">
    <div>
        <h1>Поиск друзей</h1>
        <p class="page-subtitle">Найди пользователя по имени или email и отправь заявку.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">К друзьям</a>
</div>

<form asp-action="Search" method="get" class="row g-2 mb-4">
    <div class="col">
        <input name="query"
               value="@Model.Query"
               class="form-control"
               placeholder="Имя или email (минимум 2 символа)" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Найти</button>
    </div>
</form>

@if (TempData["FriendMessage"] != null)
{
    <div class="alert alert-info">@TempData["FriendMessage"]</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Query))
{
    if (Model.Results.Count == 0)
    {
        <p class="text-muted">Ничего не найдено.</p>
    }
    else
    {
        foreach (var user in Model.Results)
        {
            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <a asp-controller="Profile"
                           asp-action="Index"
                           asp-route-userId="@user.UserId"
                           class="fw-bold text-decoration-none">
                            @user.Username
                        </a>
                        @if (!string.IsNullOrWhiteSpace(user.Bio))
                        {
                            <div class="text-muted small">@user.Bio</div>
                        }
                    </div>

                    <div class="d-flex gap-2 align-items-center">
                        @if (user.Status == FriendshipStatus.Accepted)
                        {
                            <span class="badge bg-success">Уже друзья</span>
                            <a asp-controller="Profile"
                               asp-action="Index"
                               asp-route-userId="@user.UserId"
                               class="btn btn-outline-primary btn-sm">
                                Профиль
                            </a>
                        }
                        else if (user.Status == FriendshipStatus.Pending && user.IsIncomingRequest)
                        {
                            <span class="badge bg-info text-dark">Входящая заявка</span>
                            <form asp-action="AcceptRequest" method="post">
                                <input type="hidden" name="id" value="@user.FriendshipId" />
                                <button type="submit" class="btn btn-success btn-sm">Принять</button>
                            </form>
                            <form asp-action="RejectRequest" method="post">
                                <input type="hidden" name="id" value="@user.FriendshipId" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Отклонить</button>
                            </form>
                        }
                        else if (user.Status == FriendshipStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">Заявка отправлена</span>
                            <form asp-action="CancelRequest" method="post">
                                <input type="hidden" name="id" value="@user.FriendshipId" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Отменить</button>
                            </form>
                        }
                        else if (user.Status == FriendshipStatus.Blocked)
                        {
                            <span class="badge bg-danger">Недоступен</span>
                        }
                        else
                        {
                            <form asp-action="SendRequest" method="post">
                                <input type="hidden" name="userId" value="@user.UserId" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="btn btn-primary btn-sm">
                                    @(user.Status == FriendshipStatus.Rejected ? "Отправить снова" : "Добавить")
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
}
