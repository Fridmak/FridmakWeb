@{
    ViewData["Title"] = "Главная";
}

<section class="hero mb-4">
    <h1>Fridmak Messenger</h1>
    <p class="lead mt-3 mb-4">
        Личные сообщения для друзей: добавляйте людей в друзья, начинайте переписку
        и оставайтесь на связи.
    </p>

    <div class="d-flex flex-wrap gap-2">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Messages" asp-action="Index" class="btn btn-light px-4">Открыть сообщения</a>
            <a asp-controller="Friends" asp-action="Index" class="btn btn-outline-light px-4">Мои друзья</a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-light px-4">Войти</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light px-4">Регистрация</a>
        }
    </div>
</section>

<div class="row g-3">
    <div class="col-md-4">
        <div class="feature-card">
            <h3>Личные сообщения</h3>
            <p>Переписка один на один, история сообщений и счётчик непрочитанных.</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Messages" asp-action="Index" class="btn btn-sm btn-outline-primary mt-3">К сообщениям</a>
            }
        </div>
    </div>

    <div class="col-md-4">
        <div class="feature-card">
            <h3>Друзья</h3>
            <p>Поиск людей, заявки в друзья и быстрый переход к переписке.</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Friends" asp-action="Search" class="btn btn-sm btn-outline-primary mt-3">Найти людей</a>
            }
        </div>
    </div>

    <div class="col-md-4">
        <div class="feature-card">
            <h3>Общий чат</h3>
            <p>Небольшая общая комната с ботами — просто для настроения.</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Chat" asp-action="Index" class="btn btn-sm btn-outline-primary mt-3">Открыть чат</a>
            }
        </div>
    </div>
</div>
