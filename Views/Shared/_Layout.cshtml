@using System.Security.Claims
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Fridmak</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestingAppWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/text.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Fridmak</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Открыть навигацию">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Home" && action == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Home" && action == "About" ? "active" : "")"
                               asp-controller="Home" asp-action="About">О проекте</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Messages")"
                                   asp-controller="Messages" asp-action="Index">Сообщения</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Friends")"
                                   asp-controller="Friends" asp-action="Index">Друзья</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Friends" && action == "Search" ? "active" : "")"
                                   asp-controller="Friends" asp-action="Search">Найти друзей</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Chat")"
                                   asp-controller="Chat" asp-action="Index">Общий чат</a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @Active("Admin")"
                                       asp-controller="Admin" asp-action="Index">Админка</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Profile"
                                   asp-action="Index"
                                   asp-route-userId="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value">
                                    <span class="text-muted">Вы:</span> @User.Identity.Name
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Logout">Выйти</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Home/Index">Войти</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Регистрация</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container app-main py-3">
        @RenderBody()
    </main>

    <footer class="footer py-3 text-center text-muted small">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year FridmakWeb</span>
            <span>Fridmak Messenger · личные сообщения для друзей</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
