@model TestingAppWeb.Models.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<div class="auth-card card">
    <div class="card-body">
        <h1 class="h3 mb-1">Регистрация</h1>
        <p class="page-subtitle mb-4">Создайте аккаунт, чтобы попасть в чат и добавить друзей.</p>

        <form asp-action="Register" method="post" onsubmit="return validateRegistrationForm(this)">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Создать аккаунт</button>
        </form>

        <p class="text-center text-muted mt-4 mb-0">
            Уже есть аккаунт? <a asp-action="Login">Войти</a>
        </p>
    </div>
</div>

<script type="module" src="~/js/reg-form/main.js"></script>
