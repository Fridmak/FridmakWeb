# Скопируй в .env и замени пароли на свои.
# .env не попадает в git.
POSTGRES_DB=fridmakweb
POSTGRES_USER=fridmak
POSTGRES_PASSWORD=ChangeMe_Pg!2026
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_Admin!2026

# WasmGate data-plane admin endpoint (Bearer token).
WASMGATE_ADMIN_TOKEN=ChangeMe_Wasmgate!2026

# WasmGate Control Plane admin token (UI/API on :19097 and /metrics).
WASMGATE_CP_ADMIN_TOKEN=ChangeMe_WasmgateCP!2026

# Optional: override the pinned WasmGate commit (the metrics branch is pinned in compose).
# WASMGATE_REF=metrics
# WASMGATE_VERSION=metrics

# Token for the application /metrics endpoint (Prometheus uses it).
METRICS_TOKEN=ChangeMe_Metrics!2026

# Grafana login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe_Grafana!2026
